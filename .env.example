# ─────────────────────────────────────────────────────────────
# Market Pulse — variables de entorno (PLANTILLA, sin valores reales)
# Copiá este archivo como .env y completá los valores.
# .env está en .gitignore y NO debe commitearse nunca.
# ─────────────────────────────────────────────────────────────

# ── FRONTEND (se exponen al navegador; seguras gracias a RLS) ──
# Las variables VITE_* las inyecta Vite en el build.
# En Cloudflare Pages se cargan en Settings → Environment variables.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-public-key

# ── SYNC / CRON (SOLO backend, NUNCA en el frontend) ──
# Estas dos van en GitHub → Settings → Secrets and variables → Actions.
# La service_role key tiene acceso TOTAL a la base: es un secreto.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-SECRETA
